APP_NAME="Al Azhar Memorial Garden"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
APP_IMAGE=ziarah-amg-app:local
WEB_IMAGE=ziarah-amg-web:local
BUSINESS_TIMEZONE=Asia/Jakarta
PUBLIC_AVAILABILITY_RATE_LIMIT=60
PUBLIC_BOOKING_SUBMISSION_RATE_LIMIT=5
BOOKING_MANAGEMENT_READ_RATE_LIMIT=30
BOOKING_RESCHEDULE_RATE_LIMIT=5
BOOKING_CANCEL_RATE_LIMIT=5
BOOKING_MINIMUM_FORM_SECONDS=3
BOOKING_MAXIMUM_FORM_SECONDS=7200
BOOKING_MAXIMUM_REQUEST_BYTES=16384
# Cloudflare's always-pass test keys are for local development only.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ziarah_amg
DB_USERNAME=ziarah
DB_PASSWORD=secret

POSTGRES_DB=ziarah_amg
POSTGRES_USER=ziarah
POSTGRES_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
